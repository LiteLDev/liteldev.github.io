# This repository has no package manifest: site/ is generated by a dependency-free script. Playwright for the
# kit's verification scripts (kit/scripts/*.mjs) comes from $LEVIMC_PW_DIR or an ad-hoc `npm i -D playwright`.
node_modules/
# levimc-kit, fetched from levimc.org (scripts/fetch-kit.mjs), and the site generated from it
/kit/
/site/
/package.json
/package-lock.json
# kit tooling outputs (write linkcheck/url-parity --json reports into .kit/; screenshots, caches)
.kit/
screens/
*.log
.claude/settings.local.json
