{
  "name": "levimc-org",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "vite src/main",
    "dev:mods": "node scripts/mods/run.mjs dev",
    "dev:docs": "node scripts/docs-sites.mjs dev",
    "build": "node scripts/build.mjs",
    "preview": "node src/kit/scripts/serve-pages.mjs dist --base / --port 4173",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "eslint --max-warnings 0",
    "test": "node --test \"src/**/*.test.ts\" \"src/**/*.test.mjs\" \"scripts/**/*.test.mjs\" \"content/*/scripts/**/*.test.mjs\"",
    "test:bedboo": "node --test \"content/bedboo/test/*.test.mjs\"",
    "linkcheck": "node scripts/docs-sites.mjs linkcheck dist --base / --site-origin https://levimc.org --ignore-paths /LeviLamina/api/",
    "budget": "node scripts/mods/run.mjs budget",
    "smoke": "node scripts/smoke-all.mjs",
    "kit:static": "node src/kit/static/build-static.mjs",
    "kit:assets": "node src/kit/assets/build-assets.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "9.33.1",
    "@waline/client": "3.7.1",
    "babylon-mmd": "1.3.0",
    "minisearch": "7.2.0",
    "modern-screenshot": "4.6.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router": "8.5.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "smol-toml": "1.9.1",
    "three": "0.186.0",
    "unist-util-visit": "5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@shikijs/transformers": "4.5.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@types/picomatch": "4.0.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@types/unist": "3.0.3",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "hast-util-from-html": "2.0.3",
    "hast-util-to-html": "9.0.5",
    "hast-util-to-string": "3.0.1",
    "lucide-static": "1.62.0",
    "mdast-util-to-string": "4.0.0",
    "opencc-js": "1.4.2",
    "picomatch": "4.0.7",
    "playwright": "1.65.1",
    "remark-frontmatter": "5.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "sharp": "0.34.5",
    "shiki": "4.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "unified": "11.0.5",
    "vite": "8.3.8",
    "yaml": "2.9.1"
  },
  "description": "levimc.org: the LeviMC website, LeviMC Mods and the documentation of every LeviMC project"
}
